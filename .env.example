# Option 1 — Gemini Developer API (free key at https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your-key-here

# Option 2 — Vertex AI (uses Application Default Credentials)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=us-central1

GEMINI_MODEL=gemini-3.8-flash
THINKING_LEVEL=low
MAX_UPLOAD_MB=10
